{
  "name": "@praabindh/aura-rich-content",
  "version": "1.0.0",
  "description": "Safe, accessible rich Markdown rendering for Praabindh's Aura Design System.",
  "author": "Praabindh, PRAABINDH CORP",
  "license": "MIT",
  "homepage": "https://github.com/praabindh/Aura-Design-System#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praabindh/Aura-Design-System.git",
    "directory": "packages/rich-content"
  },
  "bugs": {
    "url": "https://github.com/praabindh/Aura-Design-System/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../tooling/scripts/clean-dist.mjs && tsc -p tsconfig.build.json && cd ../.. && node tooling/scripts/copy-assets.mjs packages/rich-content",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/rich-content"
  },
  "dependencies": {
    "@praabindh/aura-tokens": "1.0.0",
    "lowlight": "3.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.14"
  }
}
